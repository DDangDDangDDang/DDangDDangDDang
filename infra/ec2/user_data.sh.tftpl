#!/bin/bash
# EC2를 처음 켤 때 한 번 실행된다. Docker·Compose를 설치하고 배포 스크립트가 쓸 설정을 남긴다.
# 앱 실행과 이후 설정 변경은 배포(deploy.sh)가 맡는다.
set -euxo pipefail

# 메모리 2GB 서버라 앱이 잠깐 메모리를 많이 써도 죽지 않도록 스왑 2GB를 둔다.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

timedatectl set-timezone Asia/Seoul

dnf install -y docker jq
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/ddang
chmod 700 /opt/ddang
cat > /opt/ddang/config.sh <<'EOF'
REGION="${region}"
REGISTRY="${registry}"
PARAM_PREFIX="${param_prefix}"
APP_SECRET_ID="${app_secret_id}"
DB_SECRET_ID="${db_secret_id}"
EOF
